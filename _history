arThreshold\"><shadow type=\"math_number_minmax\"><mutation min=\"1\" max=\"2000\" label=\"ClearThreshold\" precision=\"0\"></mutation><field name=\"SLIDER\">80</field></shadow></value></block></next></block></next></block></next></block></statement></block><block type=\"tcsColorSensor_getChannelValue\" disabled-reasons=\"pxt_automatic_disabled\" x=\"919\" y=\"0\"><field name=\"channel\">tcsColorSensor.TCSChannel.Red</field><field name=\"mode\">tcsColorSensor.ValueMode.Normalized</field></block><block type=\"tcsColorSensor_getChannelValue\" disabled-reasons=\"pxt_automatic_disabled\" x=\"-1313\" y=\"173\"><field name=\"channel\">tcsColorSensor.TCSChannel.Red</field><field name=\"mode\">tcsColorSensor.ValueMode.Normalized</field></block></xml>"]]}]},{"type":"edited","filename":"main.ts","patch":[{"start1":28,"length1":36,"diffs":[[1,""]]},{"start1":145,"length1":0,"diffs":[[1,"    tcsColorSensor.setColorProfile(\n    tcsColorSensor.AllColors.Red,\n    150,\n    50,\n    50,\n    35,\n    -1,\n    80\n    )\n"]]}]}]},{"timestamp":1794940009513,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":231,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"=5}3%w*1pENwy*Xt52_^\">ADDR</variable><variable id=\"O@uU2R_q?i(E{W|sI}z0\">hexChars</variable><variable id=\"~!^i4to7.?+H[E~/``x,\">CMD</variable><variable id=\"/bqOI@$^mCemv1iAMQ4j\">chipId</variable><variable id=\"uHvhE7h+1(*bC)W#DUm-\">ok</variable><variable id=\"gA#Eef%Fb,e!iMN{6C5B\">enableReg</variable><variable id=\"/,[1oPiT4Hdqko}.pc$6\">atimeReg</variable><variable id=\"bmclR0!/b5ND/|Spx8q+\">ctrlReg</variable></variables><block type=\"device_forever\" x=\"-1591\" y=\"-220\"><statement name=\"HANDLER\"><block type=\"tcsColorSensor_printRawSerial\"><next><block type=\"tcsColorSensor_printNormalizedSerial\"><next><block type=\"serial_writeline\"><value name=\"text\"><shadow type=\"text\"><field name=\"TEXT\">---------------------------</field></shadow></value><next><block type=\"device_pause\"><value name=\"pause\"><shadow type=\"timePicker\"><field name=\"ms\">1000</field></shadow></value></block></next></block></next></block></next></block></statement></block><block type=\"tcsColorSensor_getChannelValue\" disabled-reasons=\"pxt_automatic_disabled\" x=\"919\" y=\"0\"><field name=\"channel\">tcsColorSensor.TCSChannel.Red</field><field name=\"mode\">tcsColorSensor.ValueMode.Normalized</field></block><block type=\"tcsColorSensor_getChannelValue\" disabled-reasons=\"pxt_automatic_disabled\" x=\"-1313\" y=\"173\"><field name=\"channel\">tcsColorSensor.TCSChannel.Red</field><field name=\"mode\">tcsColorSensor.ValueMode.Normalized</field></block></xml>"]]}]},{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":39,"diffs":[[1,"basic.forever(function () {\n    tcsColorSensor.printRawSerial()\n    tcsColorSensor.printNormalizedSerial()\n    serial.writeLine(\"---------------------------\")\n    basic.pause(1000)\n})\n"]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":2,"length1":34,"diffs":[[1,"    \"name\": \"חיישן צבע\",\n"]]}]},{"type":"edited","filename":"custom.ts","patch":[{"start1":0,"length1":53,"diffs":[[1,"/**\n * ספריית חיישן צבע TCS34725 מלאה בעברית עם הגדרת Clear מפורשת\n */\n//% color=\"#e67e22\" icon=\"\\uf1fc\" block=\"חיישן צבע TCS\"\n"]]},{"start1":360,"length1":0,"diffs":[[1,"    const REG_RDATAL = 0x16;\n    const REG_GDATAL = 0x18;\n    const REG_BDATAL = 0x1A;\n"]]},{"start1":477,"length1":25,"diffs":[[1,"        //% block=\"אדום (R)\"\n"]]},{"start1":519,"length1":25,"diffs":[[1,"        //% block=\"ירוק (G)\"\n"]]},{"start1":563,"length1":25,"diffs":[[1,"        //% block=\"כחול (B)\"\n"]]},{"start1":606,"length1":30,"diffs":[[1,"        //% block=\"שקוף / עוצמת אור (Clear)\"\n"]]},{"start1":672,"length1":0,"diffs":[[1,"    export enum ValueMode {\n        //% block=\"מנורמל (0-255)\"\n        Normalized,\n        //% block=\"גולמי (RAW)\"\n        Raw\n    }\n\n"]]},{"start1":1358,"length1":0,"diffs":[[1,"    // הערה: סדר האינדקסים כאן (0-11) חייב להישאר תואם ל-DetectedColorResult\n"]]},{"start1":2802,"length1":26,"diffs":[[1,"        clearVal: number;         // אם 1- מתעלם\n"]]},{"start1":3675,"length1":221,"diffs":[[1,"        new ColorProfile(20, 20, 20, 30, 70, 50),           // Black (6) - Clear מופעל\n        new ColorProfile(95, 95, 95, 30, 800, 300),         // White (7) - Clear מופעל\n        new ColorProfile(0, 0, 0, -1, -1, 80),              // Custom1 (8) - כבוי כברירת מחדל (threshold = -1)\n"]]},{"start1":4195,"length1":31,"diffs":[[1,""]]},{"start1":4489,"length1":596,"diffs":[[1,"    function read16(reg: number): number {\n        pins.i2cWriteNumber(TCS34725_ADDR, COMMAND_BIT | reg, NumberFormat.UInt8BE, true);\n        let buf = pins.i2cReadBuffer(TCS34725_ADDR, 2, false);\n        return buf[0] | (buf[1] << 8);\n"]]},{"start1":4732,"length1":0,"diffs":[[1,"    /**\n     * קורא את כל 4 הערוצים (C, R, G, B) בבת אחת למניעת חוסר סנכרון\n     */\n"]]},{"start1":4893,"length1":22,"diffs":[[1,""]]},{"start1":5264,"length1":0,"diffs":[[1,"    /**\n     * מחזיר ערכים מנורמלים (0-255) יחד עם ערך ה-Clear הגולמי מתוך דגימה אחת מסונכרנת\n     */\n"]]},{"start1":5870,"length1":22,"diffs":[[1,"    // אתחול, הגדרות חומרה ושליטה בלד\n"]]},{"start1":5967,"length1":57,"diffs":[[1,"     * מאתחל את רכיב חיישן הצבע TCS34725\n     */\n    //% group=\"אתחול והגדרות\"\n    //% block=\"אתחל חיישן צבע TCS\"\n    //% weight=100\n    export function init(): boolean {\n        pins.i2cWriteNumber(TCS34725_ADDR, COMMAND_BIT | REG_ID, NumberFormat.UInt8BE, true);\n        let id = pins.i2cReadNumber(TCS34725_ADDR, NumberFormat.UInt8BE, false);\n        if (id != 0x44 && id != 0x4D) {\n            return false;\n        }\n\n        write8(REG_ATIME, TCSTime.Time_50ms);\n        write8(REG_CONTROL, TCSGain.Gain_4X);\n\n        write8(REG_ENABLE, 0x01 | 0x02);\n        basic.pause(50);\n\n        return true;\n    }\n\n    /**\n     * מגדיר את הפין אליו מחובר הלד ומדליק אותו\n     * @param pin מספר הפין\n     */\n    //% group=\"אתחול והגדרות\"\n    //% block=\"הגדר פין לד %pin והדלק\"\n    //% pin.defl=DigitalPin.P0\n    //% weight=98\n    export function setupLedPin(pin: DigitalPin): void {\n        ledPin = pin;\n        hasLedConfigured = true;\n        pins.digitalWritePin(ledPin, 1);\n    }\n\n    /**\n     * קובע מצב דולק או כבוי ללד\n     * @param on דלוק / כבוי\n     */\n    //% group=\"אתחול והגדרות\"\n    //% block=\"קבע לד חיישן צבע ל- %on\"\n    //% on.shadow=\"toggleOnOff\"\n    //% weight=96\n    export function setLed(on: boolean): void {\n        if (hasLedConfigured) {\n            pins.digitalWritePin(ledPin, on ? 1 : 0);\n        }\n    }\n\n    /**\n     * כוון את רגישות החיישן (הגבר)\n     * @param gain רמת ההגבר\n     */\n    //% group=\"אתחול והגדרות\"\n    //% block=\"כוון רגישות (הגבר) ל- %gain\"\n    //% weight=94\n    export function setGain(gain: TCSGain): void {\n        write8(REG_CONTROL, gain);\n    }\n\n    /**\n     * כוון את זמן דגימת הנתונים של החיישן\n     * @param time משך הדגימה\n     */\n    //% group=\"אתחול והגדרות\"\n    //% block=\"כוון זמן דגימה ל- %time\"\n    //% weight=92\n    export function setIntegrationTime(time: TCSTime): void {\n        write8(REG_ATIME, time);\n    }\n\n    // ==========================================\n    // קריאת נתונים ותצוגה\n    // ==========================================\n\n    /**\n     * קורא ערך מספרי עבור ערוץ צבע ספציפי (R, G, B או Clear)\n"]]},{"start1":8075,"length1":0,"diffs":[[1,"     * @param mode מצב ערך: מנורמל (0-255) או גולמי (RAW)\n"]]},{"start1":8169,"length1":120,"diffs":[[1,"    //% block=\"קרא ערוץ %channel בערך %mode\"\n    //% weight=90\n    export function getChannelValue(channel: TCSChannel, mode: ValueMode): number {\n        if (mode === ValueMode.Raw) {\n            switch (channel) {\n                case TCSChannel.Red: return read16(REG_RDATAL);\n                case TCSChannel.Green: return read16(REG_GDATAL);\n                case TCSChannel.Blue: return read16(REG_BDATAL);\n                case TCSChannel.Clear: return read16(REG_CDATAL);\n            }\n        }\n\n        // במצב מנורמל, קורא את הערוץ המבוקש יחד עם Clear בבת אחת לסנכרון מלא\n"]]},{"start1":8974,"length1":95,"diffs":[[1,"            case TCSChannel.Clear: return Math.min(255, sample.c);\n"]]},{"start1":9084,"length1":42,"diffs":[[1,"     * מחזיר את עוצמת האור הכללית מהחיישן (ערך ערוץ ה-Clear הגולמי 0-21504)\n"]]},{"start1":9196,"length1":50,"diffs":[[1,"    //% block=\"עוצמת אור כללית (Clear)\"\n    //% weight=88\n"]]},{"start1":9304,"length1":55,"diffs":[[1,"        return read16(REG_CDATAL);\n"]]},{"start1":9346,"length1":124,"diffs":[[1,""]]},{"start1":9354,"length1":53,"diffs":[[1,"     * מדפיס למוניטור הטורי את ערכי הצבע המנורמלים יחד עם ערך ה-Clear הגולמי\n"]]},{"start1":9468,"length1":58,"diffs":[[1,"    //% block=\"הדפס נתוני צבע ו-Clear למוניטור\"\n    //% weight=86\n"]]},{"start1":9631,"length1":112,"diffs":[[1,"        serial.writeLine(\"TCS -> R: \" + sample.r + \" | G: \" + sample.g + \" | B: \" + sample.b + \" || Clear: \" + sample.c);\n"]]},{"start1":9760,"length1":0,"diffs":[[1,"    /**\n     * מדפיס למוניטור הטורי (Serial) את כל ארבעת הערכים הגולמיים (RAW)\n     */\n    //% group=\"מוניטור טורי\"\n    //% block=\"הדפס למוניטור ערכים גולמיים (RAW)\"\n    //% weight=84\n    export function printRawSerial(): void {\n        let raw = readRawRGBC();\n        serial.writeLine(\"TCS [RAW] -> R: \" + raw.r + \" | G: \" + raw.g + \" | B: \" + raw.b + \" | C: \" + raw.c);\n    }\n\n"]]},{"start1":10190,"length1":22,"diffs":[[1,"    // הגדרה ידנית של כל הצבעים ובדיקה\n"]]},{"start1":10280,"length1":0,"diffs":[[1,"    /**\n     * מגדיר ערכי R, G, B, טווח סטייה, וערך Clear. השארת Clear על 1- תתעלם ממנו.\n     * @param color הצבע שברצונך להגדיר\n     * @param r ערך אדום (0 עד 255)\n     * @param g ערך ירוק (0 עד 255)\n     * @param b ערך כחול (0 עד 255)\n     * @param threshold טווח סטיית RGB מותר\n     * @param clearVal ערך אור Clear (הזן 1- להתעלמות)\n     * @param clearThreshold טווח סטייה מותר ל-Clear\n     */\n    //% group=\"הגדרת צבעים\"\n    //% block=\"הגדר צבע %color | R: %r G: %g B: %b סטייה: %threshold | Clear (הזן 1- להתעלמות): %clearVal סטיית Clear: %clearThreshold\"\n    //% r.min=0 r.max=255 r.defl=150\n    //% g.min=0 g.max=255 g.defl=50\n    //% b.min=0 b.max=255 b.defl=50\n    //% threshold.min=1 threshold.max=200 threshold.defl=35\n    //% clearVal.defl=-1\n    //% clearThreshold.min=1 clearThreshold.max=2000 clearThreshold.defl=80\n    //% weight=82\n    export function setColorProfile(\n        color: AllColors,\n        r: number,\n        g: number,\n        b: number,\n        threshold: number,\n        clearVal: number,\n        clearThreshold: number\n    ): void {\n        let p = colorList[color];\n        p.r = r;\n        p.g = g;\n        p.b = b;\n        p.threshold = threshold;\n        p.clearVal = clearVal;\n        p.clearThreshold = clearThreshold;\n    }\n\n    /**\n     * מחשב מרחק צבע או מחזיר 1- אם הצבע אינו מוגדר או חורג מטווח ה-Clear\n     */\n"]]},{"start1":11776,"length1":0,"diffs":[[1,"        // אם הטווח שלילי (כמו בצבעים מותאמים שטרם הוגדרו), התעלם\n"]]},{"start1":11907,"length1":0,"diffs":[[1,"        // 1. בדיקת התאמת ערוץ Clear (רק אם הוגדר ערך שאינו 1-)\n"]]},{"start1":12083,"length1":0,"diffs":[[1,"        // 2. חישוב מרחק RGB\n"]]},{"start1":12313,"length1":45,"diffs":[[1,"     * בודק האם המשטח הנוכחי תואם לצבע שנבחר לפי ההגדרות שהוזנו\n"]]},{"start1":12484,"length1":18,"diffs":[[1,"    //% weight=80\n"]]},{"start1":12704,"length1":48,"diffs":[[1,"     * מחזיר את הצבע שהכי קרוב למשטח הנקרא כרגע מתוך כל הצבעים שהוגדרו\n"]]},{"start1":12837,"length1":18,"diffs":[[1,"    //% weight=78\n"]]},{"start1":13450,"length1":2504,"diffs":[[1,""]]}]}]},{"timestamp":1794940543326,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":84,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"739\" y=\"20\"><statement name=\"HANDLER\"><block type=\"tcsColorSensor_printNormalizedSerial\"></block></statement></block></xml>"]]}]},{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":1,"diffs":[[1,"tcsColorSensor.printNormalizedSerial()\n"]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":262,"length1":44,"diffs":[[1,""]]}]},{"type":"edited","filename":"custom.ts","patch":[{"start1":6920,"length1":110,"diffs":[[1,"        serial.writeLine(\"R: \" + sample.r + \" | G: \" + sample.g + \" | B: \" + sample.b + \" | אור: \" + sample.c);\n"]]}]},{"type":"added","filename":"test.ts","value":"// tests go here; this will not be compiled when this package is used as an extension.\n"}]}],"snapshots":[{"timestamp":1794938735834,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <block type=\"pxt-on-start\"></block>\n  <block type=\"device_forever\"></block>\n</xml>","main.ts":"\n","README.md":"","pxt.json":"{\n    \"name\": \"חיישן צבע\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"additionalFilePaths\": []\n}\n"}},{"timestamp":1794940536750,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"739\" y=\"20\"></block></xml>","main.ts":"","README.md":"","custom.ts":"\n//% color=\"#e67e22\" icon=\"\\uf1fc\" block=\"חיישן צבע\"\nnamespace tcsColorSensor {\n\n    const TCS34725_ADDR = 0x29;\n    const COMMAND_BIT = 0x80;\n\n    const REG_ENABLE = 0x00;\n    const REG_ATIME = 0x01;\n    const REG_CONTROL = 0x0F;\n    const REG_ID = 0x12;\n\n    const REG_CDATAL = 0x14;\n\n    export enum TCSChannel {\n        //% block=\"אדום\"\n        Red,\n        //% block=\"ירוק\"\n        Green,\n        //% block=\"כחול\"\n        Blue,\n        //% block=\"עוצמת אור\"\n        Clear\n    }\n\n    export enum TCSGain {\n        //% block=\"1X\"\n        Gain_1X = 0x00,\n        //% block=\"4X\"\n        Gain_4X = 0x01,\n        //% block=\"16X\"\n        Gain_16X = 0x02,\n        //% block=\"60X\"\n        Gain_60X = 0x03\n    }\n\n    export enum TCSTime {\n        //% block=\"2.4ms (מהיר מאוד)\"\n        Time_2_4ms = 0xFF,\n        //% block=\"24ms\"\n        Time_24ms = 0xF6,\n        //% block=\"50ms (מומלץ לרובוט)\"\n        Time_50ms = 0xEB,\n        //% block=\"101ms\"\n        Time_101ms = 0xD6,\n        //% block=\"154ms (מדויק)\"\n        Time_154ms = 0xC0\n    }\n\n    export enum AllColors {\n        //% block=\"אדום\"\n        Red = 0,\n        //% block=\"ירוק\"\n        Green = 1,\n        //% block=\"כחול\"\n        Blue = 2,\n        //% block=\"צהוב\"\n        Yellow = 3,\n        //% block=\"כתום\"\n        Orange = 4,\n        //% block=\"סגול\"\n        Purple = 5,\n        //% block=\"שחור\"\n        Black = 6,\n        //% block=\"לבן\"\n        White = 7,\n        //% block=\"צבע מותאם 1\"\n        Custom1 = 8,\n        //% block=\"צבע מותאם 2\"\n        Custom2 = 9,\n        //% block=\"צבע מותאם 3\"\n        Custom3 = 10,\n        //% block=\"צבע מותאם 4\"\n        Custom4 = 11\n    }\n\n    export enum DetectedColorResult {\n        //% block=\"אדום\"\n        Red = 0,\n        //% block=\"ירוק\"\n        Green = 1,\n        //% block=\"כחול\"\n        Blue = 2,\n        //% block=\"צהוב\"\n        Yellow = 3,\n        //% block=\"כתום\"\n        Orange = 4,\n        //% block=\"סגול\"\n        Purple = 5,\n        //% block=\"שחור\"\n        Black = 6,\n        //% block=\"לבן\"\n        White = 7,\n        //% block=\"צבע מותאם 1\"\n        Custom1 = 8,\n        //% block=\"צבע מותאם 2\"\n        Custom2 = 9,\n        //% block=\"צבע מותאם 3\"\n        Custom3 = 10,\n        //% block=\"צבע מותאם 4\"\n        Custom4 = 11,\n        //% block=\"לא ידוע\"\n        Unknown = 12\n    }\n\n    class ColorProfile {\n        r: number;\n        g: number;\n        b: number;\n        threshold: number;\n        clearVal: number;\n        clearThreshold: number;\n\n        constructor(r: number, g: number, b: number, th: number, clearVal: number = -1, clearTh: number = 80) {\n            this.r = r;\n            this.g = g;\n            this.b = b;\n            this.threshold = th;\n            this.clearVal = clearVal;\n            this.clearThreshold = clearTh;\n        }\n    }\n\n    let colorList: ColorProfile[] = [\n        new ColorProfile(185, 45, 45, 40, -1, 80),          // Red (0)\n        new ColorProfile(40, 165, 55, 40, -1, 80),          // Green (1)\n        new ColorProfile(35, 80, 175, 40, -1, 80),          // Blue (2)\n        new ColorProfile(165, 155, 30, 40, -1, 80),         // Yellow (3)\n        new ColorProfile(195, 95, 30, 40, -1, 80),          // Orange (4)\n        new ColorProfile(120, 50, 150, 40, -1, 80),         // Purple (5)\n        new ColorProfile(20, 20, 20, 30, 70, 50),           // Black (6)\n        new ColorProfile(95, 95, 95, 30, 800, 300),         // White (7)\n        new ColorProfile(0, 0, 0, -1, -1, 80),              // Custom1 (8)\n        new ColorProfile(0, 0, 0, -1, -1, 80),              // Custom2 (9)\n        new ColorProfile(0, 0, 0, -1, -1, 80),              // Custom3 (10)\n        new ColorProfile(0, 0, 0, -1, -1, 80)               // Custom4 (11)\n    ];\n\n    let isInitialized = false;\n    let ledPin: DigitalPin = DigitalPin.P0;\n    let hasLedConfigured = false;\n\n    function write8(reg: number, val: number): void {\n        let buf = pins.createBuffer(2);\n        buf[0] = COMMAND_BIT | reg;\n        buf[1] = val;\n        pins.i2cWriteBuffer(TCS34725_ADDR, buf, false);\n    }\n\n    /**\n     * אתחול פנימי אוטומטי שקורה בפעם הראשונה שקוראים או מגדירים את החיישן\n     */\n    function ensureInit(): void {\n        if (isInitialized) return;\n\n        pins.i2cWriteNumber(TCS34725_ADDR, COMMAND_BIT | REG_ID, NumberFormat.UInt8BE, true);\n        let id = pins.i2cReadNumber(TCS34725_ADDR, NumberFormat.UInt8BE, false);\n        if (id != 0x44 && id != 0x4D) {\n            return;\n        }\n\n        write8(REG_ATIME, TCSTime.Time_50ms);\n        write8(REG_CONTROL, TCSGain.Gain_4X);\n        write8(REG_ENABLE, 0x01 | 0x02);\n        basic.pause(50);\n\n        isInitialized = true;\n    }\n\n    function readRawRGBC(): { r: number, g: number, b: number, c: number } {\n        ensureInit();\n        pins.i2cWriteNumber(TCS34725_ADDR, COMMAND_BIT | REG_CDATAL, NumberFormat.UInt8BE, true);\n        let buf = pins.i2cReadBuffer(TCS34725_ADDR, 8, false);\n        let c = buf[0] | (buf[1] << 8);\n        let r = buf[2] | (buf[3] << 8);\n        let g = buf[4] | (buf[5] << 8);\n        let b = buf[6] | (buf[7] << 8);\n        return { r: r, g: g, b: b, c: c };\n    }\n\n    function readNormalizedSample(): { r: number, g: number, b: number, c: number } {\n        let raw = readRawRGBC();\n        if (raw.c === 0) {\n            return { r: 0, g: 0, b: 0, c: 0 };\n        }\n        return {\n            r: Math.min(255, Math.round((raw.r / raw.c) * 255)),\n            g: Math.min(255, Math.round((raw.g / raw.c) * 255)),\n            b: Math.min(255, Math.round((raw.b / raw.c) * 255)),\n            c: raw.c\n        };\n    }\n\n    // ==========================================\n    // 1. קריאת ערכים\n    // ==========================================\n\n    /**\n     * קורא ערך מספרי מנורמל (0 עד 255) עבור הערוץ הנבחר\n     * @param channel הערוץ לקריאה\n     */\n    //% group=\"קריאת ערכים\"\n    //% block=\"קרא ערוץ %channel\"\n    //% weight=100\n    export function getChannelValue(channel: TCSChannel): number {\n        let sample = readNormalizedSample();\n        switch (channel) {\n            case TCSChannel.Red: return sample.r;\n            case TCSChannel.Green: return sample.g;\n            case TCSChannel.Blue: return sample.b;\n            case TCSChannel.Clear: return Math.min(255, Math.round((sample.c / 21504) * 255));\n        }\n        return 0;\n    }\n\n    /**\n     * מחזיר את עוצמת האור הכללית מהחיישן\n     */\n    //% group=\"קריאת ערכים\"\n    //% block=\"עוצמת אור כללית\"\n    //% weight=95\n    export function getLightIntensity(): number {\n        let raw = readRawRGBC();\n        return raw.c;\n    }\n\n    // ==========================================\n    // 2. מוניטור טורי\n    // ==========================================\n\n    /**\n     * מדפיס למוניטור הטורי את ערכי הצבע ועוצמת האור\n     */\n    //% group=\"מוניטור טורי\"\n    //% block=\"הדפס נתוני צבע למוניטור\"\n    //% weight=90\n    export function printNormalizedSerial(): void {\n        let sample = readNormalizedSample();\n        serial.writeLine(\"R: \" + sample.r + \" | G: \" + sample.g + \" | B: \" + sample.b + \" | אור: \" + sample.c);\n    }\n\n    // ==========================================\n    // 3. זיהוי צבעים\n    // ==========================================\n\n    function getColorDistance(colorIdx: number, r: number, g: number, b: number, c: number): number {\n        let p = colorList[colorIdx];\n\n        if (p.threshold < 0) {\n            return -1;\n        }\n\n        if (p.clearVal >= 0 && Math.abs(c - p.clearVal) > p.clearThreshold) {\n            return -1;\n        }\n\n        let dr = r - p.r;\n        let dg = g - p.g;\n        let db = b - p.b;\n        let dist = Math.sqrt(dr * dr + dg * dg + db * db);\n\n        return dist <= p.threshold ? dist : -1;\n    }\n\n    /**\n     * בודק האם המשטח הנוכחי תואם לצבע שנבחר\n     * @param color הצבע לבדיקה\n     */\n    //% group=\"זיהוי צבעים\"\n    //% block=\"האם מזוהה צבע %color ?\"\n    //% weight=85\n    export function isColor(color: AllColors): boolean {\n        let sample = readNormalizedSample();\n        return getColorDistance(color, sample.r, sample.g, sample.b, sample.c) >= 0;\n    }\n\n    /**\n     * מחזיר את הצבע שהכי קרוב למשטח הנקרא כרגע\n     */\n    //% group=\"זיהוי צבעים\"\n    //% block=\"צבע שזוהה\"\n    //% weight=80\n    export function getDetectedColor(): DetectedColorResult {\n        let sample = readNormalizedSample();\n\n        let bestMatch = -1;\n        let minDistance = 9999;\n\n        for (let i = 0; i < colorList.length; i++) {\n            let dist = getColorDistance(i, sample.r, sample.g, sample.b, sample.c);\n            if (dist >= 0 && dist < minDistance) {\n                minDistance = dist;\n                bestMatch = i;\n            }\n        }\n\n        if (bestMatch !== -1) {\n            return bestMatch as DetectedColorResult;\n        }\n\n        return DetectedColorResult.Unknown;\n    }\n\n    // ==========================================\n    // 4. הגדרת צבעים\n    // ==========================================\n\n    /**\n     * מגדיר ערכי R, G, B, טווח סטייה, ועוצמת אור. השארת עוצמת אור על 1- תתעלם ממנה.\n     */\n    //% group=\"הגדרת צבעים\"\n    //% block=\"הגדר צבע %color | R: %r G: %g B: %b סטייה: %threshold | עוצמת אור (1- להתעלמות): %clearVal סטייה: %clearThreshold\"\n    //% r.min=0 r.max=255 r.defl=150\n    //% g.min=0 g.max=255 g.defl=50\n    //% b.min=0 b.max=255 b.defl=50\n    //% threshold.min=1 threshold.max=200 threshold.defl=35\n    //% clearVal.defl=-1\n    //% clearThreshold.min=1 clearThreshold.max=2000 clearThreshold.defl=80\n    //% weight=70\n    export function setColorProfile(\n        color: AllColors,\n        r: number,\n        g: number,\n        b: number,\n        threshold: number,\n        clearVal: number,\n        clearThreshold: number\n    ): void {\n        let p = colorList[color];\n        p.r = r;\n        p.g = g;\n        p.b = b;\n        p.threshold = threshold;\n        p.clearVal = clearVal;\n        p.clearThreshold = clearThreshold;\n    }\n\n    // ==========================================\n    // 5. מתקדם (לד, רגישות וזמן דגימה)\n    // ==========================================\n\n    /**\n     * מגדיר את הפין אליו מחובר הלד ומדליק אותו\n     * @param pin מספר הפין\n     */\n    //% group=\"מתקדם\"\n    //% block=\"הגדר פין לד %pin והדלק\"\n    //% pin.defl=DigitalPin.P0\n    //% weight=60\n    export function setupLedPin(pin: DigitalPin): void {\n        ledPin = pin;\n        hasLedConfigured = true;\n        pins.digitalWritePin(ledPin, 1);\n    }\n\n    /**\n     * קובע מצב דולק או כבוי ללד\n     * @param on דלוק / כבוי\n     */\n    //% group=\"מתקדם\"\n    //% block=\"קבע לד חיישן צבע ל- %on\"\n    //% on.shadow=\"toggleOnOff\"\n    //% weight=55\n    export function setLed(on: boolean): void {\n        if (hasLedConfigured) {\n            pins.digitalWritePin(ledPin, on ? 1 : 0);\n        }\n    }\n\n    /**\n     * כוון את רגישות החיישן (הגבר)\n     * @param gain רמת ההגבר\n     */\n    //% group=\"מתקדם\"\n    //% block=\"כוון רגישות (הגבר) ל- %gain\"\n    //% weight=50\n    export function setGain(gain: TCSGain): void {\n        ensureInit();\n        write8(REG_CONTROL, gain);\n    }\n\n    /**\n     * כוון את זמן דגימת הנתונים של החיישן\n     * @param time משך הדגימה\n     */\n    //% group=\"מתקדם\"\n    //% block=\"כוון זמן דגימה ל- %time\"\n    //% weight=45\n    export function setIntegrationTime(time: TCSTime): void {\n        ensureInit();\n        write8(REG_ATIME, time);\n    }\n}","pxt.json":"{\n    \"name\": \"חיישן צבע\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"custom.ts\"\n    ],\n    \"preferredEditor\": \"blocksprj\"\n}\n"}}],"shares":[],"lastSaveTime":1794940839399}